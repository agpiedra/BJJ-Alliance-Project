generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DIRECTOR
  INSTRUCTOR
  STUDENT
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 1. SUPER_ADMIN is deliberately NOT a
/// value here (Appendix C decision 5) — it is a separate boolean on User,
/// granted only through a documented bootstrap, never representable as
/// "member of org X with role SUPER_ADMIN".
enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum StaffRole {
  DIRECTOR
  INSTRUCTOR
}

enum NotificationType {
  STRIPE_THRESHOLD
  EXAM_THRESHOLD
  NEW_SIGNUP
  WEEKLY_DIGEST
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 2. Only ADULT has real data;
/// Phase 3 seeds KIDS. Appendix B Q4 (custom tracks) is still open — a fixed
/// enum is deliberate for now, not a foreclosure of that answer.
enum Track {
  ADULT
  KIDS
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 2. Governs one (organizationId,
/// track) via PromotionConfig — "the active rule mode" the engine reads.
enum PromotionMode {
  ATTENDANCE
  TIME
  HYBRID
  MANUAL
}

/// How attendance progress toward the next stripe/degree/belt is accounted
/// (docs/PROMOTION_PROGRESS_PROPOSAL.md). CUMULATIVE is the pre-decision rule
/// (sum since Student.beltAwardedAt, stripe N needs N x threshold) and stays the
/// default so a deploy changes nothing for an existing organization.
/// PER_INTERVAL is the academy's decided rule: at most one qualifying day per
/// America/Costa_Rica calendar day, and progress resets to 0 at every award. An
/// existing organization moves to PER_INTERVAL only through
/// scripts/promotion-accounting.ts, after its read-only impact report.
enum StripeAccounting {
  CUMULATIVE
  PER_INTERVAL
}

/// Where Student.progressBaselineAt came from. SYSTEM_BASELINE = the moment the
/// system began tracking the student (creation, or the activation script for an
/// existing student) - NEVER a historical promotion. AWARD = the exact instant a
/// coach recorded a promotion.
enum ProgressBaselineKind {
  SYSTEM_BASELINE
  AWARD
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 2. MANUAL/AUTO distinguish a
/// human confirm from a scheduled job (spec: "do not invent a human
/// awardedBy user" for automatic awards — see Promotion.awardedById below).
/// CORRECTION is declared now, ahead of Phase 2d's manual-correction action,
/// so that action's migration is purely additive columns, never an enum
/// value add on a live column.
enum PromotionSource {
  MANUAL
  AUTO
  CORRECTION
  TRACK_CHANGE
}

enum StudentStatus {
  PENDING
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AttendanceType {
  CHECKIN
  ADJUSTMENT
}

enum AttendanceSource {
  KIOSK
  PORTAL
  STAFF
}

enum PaymentStatus {
  PAID
  PENDING
  PROMO
  EXEMPT
}

// REDESIGN_BRIEF.md Phase 6.2 asks for a "PaymentMethod" enum — none existed.
enum PaymentMethod {
  SINPE
  TRANSFERENCIA
  EFECTIVO
  TARJETA
}

/// The currency an ORGANIZATION prices in — one per organization, the same way
/// `timezone` sits on Organization. Amounts are stored as bare decimals with no
/// unit, so every stored amount is only meaningful next to one of these:
/// `PaymentPeriod.currency` records which, per row. Adding a value is an
/// additive migration; every place that formats money takes a `Currency`.
enum Currency {
  CRC
  USD
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// How an AttendanceRecord got the class it is attributed to (REDESIGN_BRIEF.md
/// Phase 9). AUTO is the default because every row written before this enum
/// existed came from the all-or-nothing nearest-class matcher
/// (src/lib/scheduling/check-in-window.ts) — a tap that matched nothing was
/// rejected outright back then, so no pre-existing row can be anything else.
enum AttendanceMatchSource {
  AUTO
  STUDENT_PICKED
  STAFF_CORRECTED
  UNMATCHED
}

enum ClassType {
  GI
  NO_GI
  STRIKING
  KIDS
  OPEN_MAT
  COMPETITION
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 1 — the SaaS tenant. Distinct from
/// Academy (a physical branch within one Organization): never conflate the
/// two, per the spec's own terminology table.
model Organization {
  id            String             @id @default(cuid())
  slug          String             @unique
  name          String
  shortName     String?
  status        OrganizationStatus @default(PENDING)
  timezone      String             @default("America/Costa_Rica")
  defaultLocale String             @default("es")
  /// What this organization prices in. The same "assumes Costa Rica" family as
  /// `timezone` — a currency was hardcoded ("₡") in the UI until revision 34.
  /// Changing it later is allowed and never rewrites history: every recorded
  /// payment carries its own `PaymentPeriod.currency`, and plan default
  /// amounts are NOT converted (they are bare numbers in whatever this was).
  currency      Currency           @default(CRC)
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  internalNotes String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  approvedAt    DateTime?
  approvedById  String?

  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 5 — public registration form
  /// fields, persisted verbatim per the doc's own "persist all submitted
  /// registration fields" requirement. country/city feed the default
  /// Academy created on approval ("named after the city").
  country          String?
  city             String?
  studentCountBand String?
  referralSource   String?
  /// No real terms-of-service document exists yet (flagged explicitly in
  /// this phase's own PR) — these record acceptance of whatever the
  /// registration form currently shows, not a real legal record. Do not
  /// treat termsAcceptedAt as proof of agreement to real terms until a real
  /// document exists and this comment is updated to point at it.
  termsVersion     String?
  termsAcceptedAt  DateTime?

  /// Phase 5 — null until the director completes (or explicitly skips) the
  /// first-login onboarding wizard. Gates the /onboarding redirect; never
  /// reset once set (idempotent/non-reentrant per the doc).
  onboardingCompletedAt DateTime?
  /// Which of the 3 wizard steps to resume at (1-indexed) — persisted, not
  /// URL/client state, per the doc's own acceptance criterion: "uploading a
  /// logo in step 2, closing the browser, and signing in again resumes at
  /// step 3 with the logo still set." Advanced by the wizard's own
  /// advanceOnboardingStep action after each step's save (or skip)
  /// succeeds; irrelevant once onboardingCompletedAt is set.
  onboardingStep        Int       @default(1)

  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Item 2 — the dashboard's "you skipped
  /// branding, finish it here" card (wizard's own acceptance criteria).
  /// Null shows the card (per organization dismissal, not a per-browser
  /// cookie/localStorage flag — a director on a second device must see the
  /// same dismissed state). Never reset once set; re-completing branding
  /// doesn't need to un-dismiss it, since the card's own visibility
  /// condition (no logo uploaded yet) already stops showing it once
  /// branding is actually finished.
  brandingReminderDismissedAt DateTime?

  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 6 billing — platform billing (the
  /// organization paying Alexis for the app), a distinct concept from the
  /// student-facing Pagos section (PaymentPlan/PaymentPeriod). Never merge
  /// the two models, pages, or terminology (the doc's own explicit rule).
  /// The platform default applied to NEWLY ISSUED invoices only — see
  /// OrganizationInvoice.graceDaysApplied's own doc comment for why this
  /// value is snapshotted rather than read live by every invoice.
  graceDays   Int     @default(5)
  billingNote String?

  approvedBy          User?                    @relation("OrganizationApprovedBy", fields: [approvedById], references: [id])
  memberships         OrganizationMembership[]
  academies           Academy[]
  students            Student[]
  classSessions       ClassSession[]
  attendanceRecords   AttendanceRecord[]
  promotions          Promotion[]
  promotionCredits    PromotionCredit[]
  beltRanks           BeltRank[]
  invoices            OrganizationInvoice[]
  promotionConfigs    PromotionConfig[]
  paymentPlans        PaymentPlan[]
  paymentPeriods      PaymentPeriod[]
  kioskAttempts       KioskAttempt[]
  staffAssignments    StaffAssignment[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  invitations         Invitation[]
  usersLastActiveHere User[]                   @relation("UserLastActiveOrganization")
  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 4 — genuinely 1:1, but typed
  /// optional here (Prisma can't express "always exists" from this side of a
  /// shared-primary-key relation). In practice it always exists: created in
  /// the same transaction as the Organization (Phase 5's registration flow,
  /// and this migration's own Alliance backfill via prisma/seed.ts). The one
  /// read path (get-branding.ts) still degrades to system defaults rather
  /// than throwing if it's ever somehow missing — a wrong theme is a visual
  /// bug, not a tenant-isolation failure, so fail-soft is deliberate here,
  /// unlike everywhere else in this file.
  branding            OrganizationBranding?
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 6 billing — platform invoices,
/// created manually by a SUPER_ADMIN (v1: no scheduled job creates one —
/// verified by test). A distinct model from PaymentPlan/PaymentPeriod
/// (student-facing) by the doc's own explicit rule; never reused, never
/// shared terminology.
///
/// Every derived value (state, deadline) is computed at read time from the
/// fields below — see src/lib/billing/deadline.ts — never stored, so a
/// grace-days or extension change is instantly reflected without a backfill.
model OrganizationInvoice {
  id                 String   @id @default(cuid())
  organizationId     String
  periodStart        DateTime
  periodEnd          DateTime
  /// A calendar date, not an instant — compared against
  /// `DateTime.now().setZone(organization.timezone)`, never UTC or the
  /// server's local zone (deadline.ts's own doc comment has the exact
  /// precision rules).
  dueOn              DateTime
  /// Snapshot of `Organization.graceDays` AT ISSUE TIME, never read live —
  /// a deadline a customer has already been told must never move silently
  /// when the platform default later changes. Changing `graceDays` affects
  /// only invoices issued after the change; this field is why.
  graceDaysApplied   Int      @default(5)
  /// Explicit per-invoice extension, on top of graceDaysApplied — the only
  /// way to move an OUTSTANDING invoice's own deadline (doc: "use the
  /// explicit per-invoice extension").
  graceExtensionDays Int      @default(0)

  paidAt       DateTime?
  paidNote     String?
  recordedById String?

  voidedAt   DateTime?
  voidReason String?

  /// Scoped to ONE expiration episode — set to the `flaggedFrom` date that
  /// was current when acknowledged. If a later extension pushes the
  /// deadline out and the invoice expires AGAIN, this stale value no longer
  /// matches the new `flaggedFrom`, so a fresh review item reappears
  /// automatically — an old acknowledgment can never suppress it
  /// indefinitely (deadline.ts's own `isUnreviewed` implements this exactly
  /// as the doc specifies, including the canonical-date-value comparison
  /// rule: never compare by `Date` object identity).
  reviewAcknowledgedAt           DateTime?
  reviewAcknowledgedById         String?
  reviewNote                     String?
  reviewAcknowledgedForFlaggedOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id])
  recordedBy           User?        @relation("OrganizationInvoiceRecordedBy", fields: [recordedById], references: [id])
  reviewAcknowledgedBy User?        @relation("OrganizationInvoiceReviewAcknowledgedBy", fields: [reviewAcknowledgedById], references: [id])

  @@index([organizationId])
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 4 — per-organization branding.
/// `organizationId` is the primary key (not a separate cuid `id`): this
/// relation is genuinely 1:1, and using the FK as the PK makes "every
/// organization has exactly one branding row" structurally visible rather
/// than something every reader has to defensively check for.
///
/// Only backgrounds are ever stored — every foreground is derived from
/// luminance at read time in src/lib/theme.ts, never persisted, so a future
/// improvement to the derivation algorithm applies to every organization
/// automatically instead of needing a backfill. The four sidebarXxx fields
/// below are nullable for exactly this reason: null means "derive from
/// sidebarBackground," a real value means the director explicitly typed an
/// override into the settings page's advanced per-token picker.
///
/// `accentColor`/`surfaceStyle` from the original Phase 4 draft are
/// deliberately absent: neither has a defined meaning anywhere in this
/// codebase's actual token system (verified directly — `--primary`/
/// `--accent` are fixed neutral ink tokens with their own explicit "never
/// themed" ruling in globals.css; the one real brand-color knob is
/// `--brand-gold`/`--brand-gold-foreground`, which `primaryColor` alone
/// already covers) — same reasoning that cut `surfaceStyle`, applied
/// consistently rather than carrying an undefined field forward.
model OrganizationBranding {
  organizationId String  @id
  /// Friendly public-facing name (wizard step 1: "confirm or edit name and
  /// displayName") — distinct from Organization.name, the internal/admin
  /// identifier. Null falls back to Organization.name at read time.
  displayName    String?

  /// Supabase Storage public URL — never bytes in Postgres. See
  /// src/lib/branding/logo-storage.ts for why the bucket is public and the
  /// upload/delete ordering that keeps a row from ever pointing at a
  /// deleted object.
  logoUrl       String?
  logoMimeType  String?
  logoUpdatedAt DateTime?

  /// The one brand-color knob (see this model's own doc comment for why
  /// there's exactly one, not two). Overrides `--brand-gold`; its foreground
  /// is always derived, never stored — see src/lib/theme.ts.
  primaryColor String @default("#FACC15")

  /// The sidebar's own five-token palette (doc: "chosen independently" of
  /// primaryColor). Only the background is required; the other four are
  /// derive-unless-overridden, per this model's own doc comment.
  sidebarBackground       String  @default("#111827")
  sidebarForeground       String?
  sidebarActiveBackground String?
  sidebarActiveForeground String?
  sidebarBorder           String?

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

/// The only authorization source for ADMIN/DIRECTOR/INSTRUCTOR/STUDENT access
/// (Appendix C decision 4) — User.role is retained temporarily during the
/// staged migration (see that decision's 4-step sequence) but membership,
/// not the role column, is what every new authorization check reads.
model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  /// Deactivation is PER ORGANIZATION, and this is where it lives. `User.active`
  /// is the ACCOUNT's switch (false = an invited account that has not yet set a
  /// password, or a disabled account) — using it to remove someone from one
  /// organization locks them out of every organization they belong to. Checked
  /// in `resolveContext` (tenant/context.ts) on every request, so a deactivation
  /// takes effect on the very next one. Assignments (`StaffAssignment`) are kept
  /// while inactive, so a reactivation restores the same scope.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Academy {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  address        String?
  timezone       String   @default("America/Costa_Rica")
  kioskTokenHash String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  staffAssignments  StaffAssignment[]
  homeStudents      Student[]          @relation("HomeAcademy")
  classSessions     ClassSession[]
  attendanceRecords AttendanceRecord[]
  promotions        Promotion[]
  promotionCredits  PromotionCredit[]
  paymentPlans      PaymentPlan[]
  paymentPeriods    PaymentPeriod[]
  auditLogs         AuditLog[]
  kioskAttempts     KioskAttempt[]

  // Composite FK target: MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 1 requires
  // e.g. "a student's home branch belongs to the same organization" enforced
  // by the database, not just application code. Every model below that
  // references an Academy does so via (organizationId, academyId) against
  // this composite unique, so a cross-organization pairing is rejected by
  // Postgres itself, not merely by a query filter someone could forget.
  @@unique([organizationId, id])
  @@index([organizationId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// NOT an authorization source. This is a legacy account-level value, written when
  /// the account is created; it once gated whole route trees, and nothing may read it
  /// for a gate now. Access is MEMBERSHIP: `OrganizationMembership.role` for the
  /// organization the person is acting in, plus a linked ACTIVE `Student` record for
  /// the portal — derived from the database as the session's `{ staff, portal }`
  /// claim (src/lib/auth/route-access.ts, derive-access.ts). A person who both teaches
  /// and trains has ONE account with a staff membership and a student record; this
  /// column cannot say that, which is why it cannot be trusted to. Enforced by
  /// tests/unit/user-role-is-not-authorization.test.ts (an explicit allowlist of the
  /// few files that may still read it).
  role         Role
  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 1, Appendix C decision 5 — a
  /// platform-wide grant, explicitly bootstrapped, never inferred from a
  /// form/profile field and never representable inside OrganizationMembership.role.
  isSuperAdmin Boolean  @default(false)
  locale       String   @default("es")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Persisted "last chosen organization" for a user with more than one
  /// active membership — read at sign-in ONLY as a fast-path candidate
  /// (src/lib/tenant/active-organization.ts re-validates it's still a real,
  /// active membership before trusting it; a stale/revoked value falls
  /// through to the explicit picker, never silently trusted). Never read
  /// for a user with zero or exactly one membership — those cases don't
  /// need it.
  lastActiveOrganizationId String?

  staffAssignments        StaffAssignment[]
  student                 Student?
  auditLogs               AuditLog[]
  promotionsAwarded       Promotion[]
  promotionCreditsGranted PromotionCredit[]
  paymentPeriodsRecorded  PaymentPeriod[]
  notifications           Notification[]
  organizationMemberships OrganizationMembership[]
  organizationsApproved   Organization[]           @relation("OrganizationApprovedBy")
  lastActiveOrganization  Organization?            @relation("UserLastActiveOrganization", fields: [lastActiveOrganizationId], references: [id])

  attendanceRecordsCreated               AttendanceRecord[]    @relation("AttendanceCreatedBy")
  attendanceRecordsCorrected             AttendanceRecord[]    @relation("AttendanceCorrectedBy")
  passwordResetTokens                    PasswordResetToken[]
  invitationsSent                        Invitation[]          @relation("InvitationInvitedBy")
  organizationInvoicesRecorded           OrganizationInvoice[] @relation("OrganizationInvoiceRecordedBy")
  organizationInvoicesReviewAcknowledged OrganizationInvoice[] @relation("OrganizationInvoiceReviewAcknowledgedBy")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 5 — a table of its own, NOT an
/// extension of PasswordResetToken. Traced directly: PasswordResetToken.userId
/// is required and non-nullable, meaning it fundamentally means "prove you
/// own THIS EXISTING account's email." A director invitation's whole point
/// is that no User row exists yet for the common case (a brand-new academy)
/// — making userId nullable plus bolting on organizationId/role/a purpose
/// discriminator onto a table every existing caller assumes always has a
/// real user is the same "everything must remember to filter" shape this
/// project already rejected once for PromotionCredit. Reuses the SAME
/// hashing/expiry/single-use/resend-invalidates-prior-token PATTERN as
/// PasswordResetToken (see forgot-password/actions.ts), not the table.
model Invitation {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  email          String
  organizationId String
  role           Role
  /// Null for a bootstrap/system-issued invitation — mirrors AuditLog.actorId's
  /// own nullability reasoning (Phase 2c-iii): a real absence is not a data gap.
  invitedById    String?
  /// The academies a DIRECTOR/INSTRUCTOR invitee is assigned to when they
  /// accept (empty for an ADMIN/Owner, whose scope is every academy). Validated
  /// against the organization's academies when the invitation is issued AND
  /// again when it is accepted.
  academyIds     String[]  @default([])
  expiresAt      DateTime
  /// Consumed by acceptance, or superseded by a newer invitation to the same
  /// address (approve/resend). NOT the same as `revokedAt`.
  usedAt         DateTime?
  /// Withdrawn by the Owner before it was accepted. A revoked link is dead
  /// exactly like a used one; kept as its own column so the staff page can tell
  /// "accepted" from "withdrawn" and the audit trail stays honest.
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 5 — the public registration form's
/// rate limiter. Deliberately NOT AuditLog: AuditLog.entityType/entityId are
/// non-nullable and must reference a real, already-existing entity, but a
/// rate-limited registration attempt — the common case this table exists
/// for — often creates nothing at all. A transient, high-volume counter also
/// has a fundamentally different purpose and retention shape than a
/// permanent record of real actions against real entities; mixing the two
/// would force every AuditLog reader (Phase 6's own audit trail) to filter
/// out rate-limit noise. No relations: an attempt from an unrecognized email
/// or a rejected/duplicate submission still needs to count.
model RegistrationAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

model StaffAssignment {
  id             String    @id @default(cuid())
  userId         String
  academyId      String
  organizationId String
  role           StaffRole
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id])
  academy      Academy      @relation(fields: [organizationId, academyId], references: [organizationId, id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, academyId])
  @@index([academyId])
  @@index([organizationId])
}

model Student {
  id                   String               @id @default(cuid())
  userId               String?              @unique
  homeAcademyId        String
  organizationId       String
  firstName            String
  lastName             String
  phone                String
  email                String
  dateOfBirth          DateTime?
  guardianName         String?
  guardianPhone        String?
  emergencyContact     String?
  currentStripes       Int                  @default(0)
  beltAwardedAt        DateTime             @default(now())
  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 2. ADULT for every pre-Phase-3
  /// student — Phase 3 adds the KIDS onboarding flow.
  track                Track                @default(ADULT)
  /// Replaces the old `currentBelt` enum column (dropped in this same
  /// constrain migration) — backfilled from it by
  /// scripts/backfill-belt-ranks.ts, verified equal by
  /// scripts/verify-belt-migration.ts before this column was made required.
  currentRankId        String
  /// The instant of this student's LAST promotion, for time-based ranks (black
  /// belt degrees): the next degree is due timeAnchorAt + the rank's interval.
  /// Written by every award with the exact award instant (stripe, belt, track
  /// change), and by a coach's explicit correction when the actual last-award
  /// date of an existing student is supplied. Null = "last-award date needed":
  /// no due date is shown and one is never invented. Deliberately separate from
  /// beltAwardedAt (spec: "keep time anchors separate from cumulative attendance
  /// accounting").
  timeAnchorAt         DateTime?
  /// Start of the CURRENT progress interval under StripeAccounting.PER_INTERVAL:
  /// only qualifying days whose first qualifying attendance is at or after this
  /// instant count toward the next stripe/degree/belt. Set to the exact award
  /// instant by every promotion; otherwise the moment the system began tracking
  /// the student. Deliberately separate from beltAwardedAt (the historical belt
  /// date, possibly typed by staff and possibly unknown) - a missing historical
  /// date never blocks attendance progress, and a historical promotion is never
  /// invented. The default fills it for every writer, old code included.
  progressBaselineAt   DateTime             @default(now())
  progressBaselineKind ProgressBaselineKind @default(SYSTEM_BASELINE)
  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 1: "Replace global student
  /// code-hash uniqueness with organization-scoped uniqueness" — see the
  /// @@unique([organizationId, codeHash]) below. No longer @unique on its own.
  codeHash             String
  status               StudentStatus        @default(PENDING)
  /// What a restore returns this student to. Set when they are archived, read and
  /// cleared when they are restored; null for everyone not currently archived — and
  /// for anyone archived before this column existed, whom a restore sends to PENDING
  /// (unknown history is never guessed as "approved"). STORED, not derived from the
  /// audit log: an audit row records what happened and gets pruned, rotated and
  /// exported, so no code path may depend on one. (Same principle as
  /// PaymentPeriod's currency snapshot and the promotion credit's belt anchor:
  /// store what you will need later.)
  statusBeforeArchive  StudentStatus?
  joinedAt             DateTime             @default(now())
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user              User?              @relation(fields: [userId], references: [id])
  homeAcademy       Academy            @relation("HomeAcademy", fields: [organizationId, homeAcademyId], references: [organizationId, id])
  currentRank       BeltRank           @relation("CurrentRank", fields: [organizationId, currentRankId], references: [organizationId, id])
  attendanceRecords AttendanceRecord[]
  promotions        Promotion[]
  promotionCredits  PromotionCredit[]
  paymentPeriods    PaymentPeriod[]
  organization      Organization       @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, codeHash])
  @@unique([organizationId, id])
  @@index([homeAcademyId])
  @@index([organizationId])
  @@index([currentRankId])
}

model ClassSession {
  id                    String    @id @default(cuid())
  academyId             String
  organizationId        String
  dayOfWeek             DayOfWeek
  startTime             String
  durationMinutes       Int
  name                  String
  type                  ClassType
  countsTowardPromotion Boolean   @default(true)
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  academy           Academy            @relation(fields: [organizationId, academyId], references: [organizationId, id])
  attendanceRecords AttendanceRecord[]
  organization      Organization       @relation(fields: [organizationId], references: [id])

  @@unique([academyId, dayOfWeek, startTime, name])
  @@unique([organizationId, id])
  @@index([academyId])
  @@index([organizationId])
}

model AttendanceRecord {
  id             String                @id @default(cuid())
  studentId      String
  academyId      String
  organizationId String
  classSessionId String?
  occurredAt     DateTime
  /// Calendar date in America/Costa_Rica (UTC-6, no DST), NOT a naive UTC
  /// slice of occurredAt — most evening classes (18:00+ CR) fall on the next
  /// UTC calendar day. Whoever writes this field (Phase 3) must derive it via
  /// Luxon + the project's America/Costa_Rica zone helper, never
  /// `occurredAt.toISOString().slice(0, 10)`.
  date           DateTime              @db.Date
  type           AttendanceType
  delta          Int                   @default(1)
  source         AttendanceSource
  reason         String?
  createdById    String?
  createdAt      DateTime              @default(now())
  /// Provenance of `classSessionId`. UNMATCHED means the tap happened on a day
  /// with no classes at all, so `classSessionId` is null and staff review it
  /// from the Kiosco page's "Marcajes de hoy" table.
  matchSource    AttendanceMatchSource @default(AUTO)
  /// Set only by the STAFF_CORRECTED path. `occurredAt` deliberately stays the
  /// raw instant of the original tap even after a correction.
  correctedById  String?
  correctedAt    DateTime?

  student      Student       @relation(fields: [organizationId, studentId], references: [organizationId, id])
  academy      Academy       @relation(fields: [organizationId, academyId], references: [organizationId, id])
  classSession ClassSession? @relation(fields: [organizationId, classSessionId], references: [organizationId, id])
  // Two distinct relations to User (who wrote it vs. who corrected it) — Prisma
  // requires an explicit name on each to tell them apart.
  createdBy    User?         @relation("AttendanceCreatedBy", fields: [createdById], references: [id])
  correctedBy  User?         @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])

  @@unique([studentId, classSessionId, date])
  @@index([studentId, occurredAt])
  @@index([academyId, occurredAt])
  @@index([organizationId])
}

model Promotion {
  id             String          @id @default(cuid())
  studentId      String
  academyId      String
  organizationId String
  fromStripes    Int
  toStripes      Int
  /// Replace the old `fromBelt`/`toBelt` enum columns (dropped in this same
  /// constrain migration) — backfilled and verified the same way
  /// Student.currentRankId was, above.
  fromRankId     String
  toRankId       String
  /// Nullable so an automatic-job award never has to invent a human actor
  /// (spec: "do not invent a human awardedBy user") — see `source` below,
  /// which is what actually distinguishes a human confirm from a job run.
  awardedById    String?
  /// Every row up to and including Phase 1 was a manual queue confirm — the
  /// @default(MANUAL) below is the factually correct backfilled value for
  /// all of them, not a placeholder.
  source         PromotionSource @default(MANUAL)
  awardedAt      DateTime        @default(now())
  notes          String?

  student      Student      @relation(fields: [organizationId, studentId], references: [organizationId, id])
  academy      Academy      @relation(fields: [organizationId, academyId], references: [organizationId, id])
  fromRank     BeltRank     @relation("PromotionFromRank", fields: [organizationId, fromRankId], references: [organizationId, id])
  toRank       BeltRank     @relation("PromotionToRank", fields: [organizationId, toRankId], references: [organizationId, id])
  awardedBy    User?        @relation(fields: [awardedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([studentId])
  @@index([organizationId])
  @@index([fromRankId])
  @@index([toRankId])
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 3d — "Estado inicial" onboarding
/// credit. Deliberately NOT rows in AttendanceRecord (Phase 3d's own ruling:
/// "every analytics query must remember to exclude X" is the argument
/// against a discriminator column, and the same argument kills fake
/// AttendanceRecord rows outright) — this table is opt-IN for the promotion
/// engine (attendance-summary.ts explicitly sums it in) rather than opt-OUT
/// for every attendance/retention/analytics query, which never join this
/// table at all and are therefore structurally blind to it, not merely
/// disciplined about excluding it.
///
/// Append-only ledger, same philosophy as AttendanceRecord's ADJUSTMENT rows
/// (attendance-summary.ts, adjustment-actions.ts): a correction is a NEW row
/// with a signed `classesGranted`, never a mutation of a prior grant — every
/// estimate and every fix to it stays permanently visible for the
/// auditability this exists for ("explainable to a student who asks why
/// they were passed over").
model PromotionCredit {
  id                  String   @id @default(cuid())
  studentId           String
  academyId           String
  organizationId      String
  /// Snapshot of Student.beltAwardedAt at the moment this credit was
  /// granted — the belt period it applies to, the same anchor
  /// attendance-summary.ts already filters AttendanceRecord by
  /// (`occurredAt >= beltAwardedAt`). A later BELT award moves
  /// Student.beltAwardedAt to `new Date()` (award.ts), so this anchor stops
  /// matching and the credit silently drops out of the engine's sum —
  /// retained forever for audit, never deleted or mutated, simply out of
  /// scope. A STRIPE award never touches beltAwardedAt (award.ts's
  /// `studentUpdate: {}`), so a credit survives it unchanged.
  beltAwardedAtAnchor DateTime
  /// Signed, same reasoning as AttendanceRecord.delta: a correction is a
  /// new row with a negative delta, not an edit of the original estimate.
  classesGranted      Int
  reason              String
  grantedById         String?
  grantedAt           DateTime @default(now())

  student      Student      @relation(fields: [organizationId, studentId], references: [organizationId, id])
  academy      Academy      @relation(fields: [organizationId, academyId], references: [organizationId, id])
  grantedBy    User?        @relation(fields: [grantedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([studentId, beltAwardedAtAnchor])
  @@index([organizationId])
}

/// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 2. Replaces BeltRequirement
/// (dropped below) — strictly organization-owned, no per-academy override.
/// Appendix B Q1 (answered with evidence during
/// planning): branch overrides never existed in real data, and are
/// semantically undefined anyway once a student's attendance pools
/// cross-branch into one progression, which is how Alliance actually works.
/// If a real customer ever needs per-branch rules, that is designed then,
/// against an actual requirement — pre-launch this would be a cheap
/// migration, not a reason to carry a dead fallback path into two new
/// tables the way BeltRequirement's own academyId column sat unused.
model BeltRank {
  id                   String         @id @default(cuid())
  organizationId       String
  track                Track
  /// Stable string key, e.g. "WHITE" — doubles as the belt.<code> i18n
  /// lookup key, preserving every existing translation call site. A string,
  /// not an enum, because the value set must vary by (organization, track)
  /// once Phase 3 seeds KIDS codes; a Prisma enum's value set is fixed at
  /// the schema level and can't do that.
  code                 String
  /// Rank labels are per-organization DATA, not translation-file keys (spec
  /// rev 19) — a customer academy can rename a rank or define one this
  /// codebase never anticipated, and a message-file key would have nothing
  /// to look up for it. The label travels with the row. `belt.<code>` i18n
  /// keys still exist for the two purely-static, non-org-driven uses (the
  /// marketing landing page and the pre-Phase-3b `/dev/belts` stub) — never
  /// for a real loaded rank.
  labelEs              String
  labelEn              String
  /// Promotion sequence within (organizationId, track), 1-based (spec rev
  /// 18): rank order+1 is "the next rank" from order. Enforced unique here;
  /// contiguity (no gaps, starts at 1) is a validation-function concern
  /// (src/lib/promotion/config.ts), not a DB constraint.
  order                Int
  maxStripes           Int
  /// Null only when this track has never used ATTENDANCE/HYBRID mode.
  /// Deliberately NOT nulled just because the currently active mode doesn't
  /// read it — see src/lib/promotion/config.ts's updateTrackConfig, which
  /// preserves whichever mode's fields it isn't asked to change so a
  /// director switching ATTENDANCE -> TIME -> ATTENDANCE gets their
  /// original numbers back, not a blank form.
  attendancesPerStripe Int?
  attendancesForExam   Int?
  /// Null only when this track has never used TIME/HYBRID mode. Same
  /// preserve-on-switch contract as the attendance fields above.
  monthsPerStripe      Int?
  monthsForExam        Int?
  /// Optional per-rank override of the track's PromotionConfig.mode. Null =
  /// use the track's mode. Lets adult white-brown stay attendance-based while
  /// black is time-based (docs/PROMOTION_PROGRESS_PROPOSAL.md).
  progressionMode      PromotionMode?
  /// Months required to reach degree i+1 from degree i on this rank (index =
  /// the student's CURRENT degree count). Empty = fall back to monthsPerStripe.
  /// An entry beyond the array (while currentStripes < maxStripes) means "that
  /// degree is not configured yet" - never "impossible".
  stripeIntervalMonths Int[]          @default([])
  /// Spec: "Terminal ranks may award remaining degrees if configured to do
  /// so. After their final degree, nextTarget is NONE." True on exactly the
  /// highest-`order` rank in the track — validated, not inferred from
  /// `order` alone.
  isTerminal           Boolean        @default(false)
  /// One entry per stripe slot, length == maxStripes. Phase 3 renders these
  /// as tape colors; Phase 2 seeds and validates but nothing reads them yet.
  stripeColors         String[]
  /// The belt bar's own tape-slot ceiling (Appendix A: "always draws at
  /// most 4 tapes ... while the counter climbs to maxStripes") — independent
  /// of maxStripes so a rank with more degrees than visible slots stays
  /// representable.
  visibleStripeSlots   Int            @default(4)
  /// Phase 3b: real per-row color data, replacing the hardcoded adult-only
  /// BELT_FILL_CLASS/TIP_FILL_CLASS Tailwind-token maps — same "data, not a
  /// fixed enum" reasoning as labelEs/labelEn (rev 19). Hex strings, not
  /// CSS custom properties: a customer catalog's colors can't be assumed to
  /// exist as a design token.
  primaryColor         String
  /// The color of the centre stripe band running lengthwise through the
  /// middle third of the belt (e.g. grey_white's white band on a grey
  /// belt), null for a rank with no centre stripe. Revision 21: replaces
  /// isSplit + splitColor — a kids "_white"/"_black" rank is its own color
  /// with a contrasting band down the centre, not two colored halves.
  centerStripeColor    String?
  /// The rank bar's own color — spec: "never hardcode black: a black belt's
  /// bar is red, and coral belts differ again."
  barColor             String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  currentStudents Student[]    @relation("CurrentRank")
  promotionsFrom  Promotion[]  @relation("PromotionFromRank")
  promotionsTo    Promotion[]  @relation("PromotionToRank")

  // Composite FK target, same convention as Academy's own @@unique([organizationId, id])
  // (Phase 1) — Student.currentRank / Promotion.fromRank / Promotion.toRank
  // all reference (organizationId, id) together, so a cross-organization
  // rank reference is rejected by Postgres itself.
  @@unique([organizationId, id])
  @@unique([organizationId, track, code])
  @@unique([organizationId, track, order])
  @@index([organizationId])
}

model PromotionConfig {
  id                    String           @id @default(cuid())
  organizationId        String
  track                 Track
  mode                  PromotionMode
  /// Always true: promotions are manual only (academy decision). Kept as a
  /// column so historical rows and old readers stay valid; a raw CHECK
  /// constraint in migration 20260923214031_promotion_reset_accounting rejects false.
  requiresCoachApproval Boolean          @default(true)
  stripeAccounting      StripeAccounting @default(CUMULATIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, track])
  @@index([organizationId])
}

model PaymentPlan {
  id             String   @id @default(cuid())
  academyId      String
  organizationId String
  name           String
  description    String?
  /// What this plan normally costs, in the ORGANIZATION's currency at the time
  /// it was set. Only a suggestion: it pre-fills the amount when a plan is
  /// picked, and the amount actually recorded is always the director's own
  /// (`PaymentPeriod.amount`), editable per payment. Changing it never
  /// touches a payment already recorded. Not converted if the organization's
  /// currency later changes. Null = no standard price (e.g. a scholarship).
  defaultAmount  Decimal? @db.Decimal(10, 2)
  /// Plans are DEACTIVATED, never deleted: historical `PaymentPeriod` rows
  /// reference them and deleting one would orphan the record of money that
  /// actually changed hands. No code deletes a plan; a test enforces that.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academy        Academy         @relation(fields: [organizationId, academyId], references: [organizationId, id])
  paymentPeriods PaymentPeriod[]
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@unique([academyId, name])
  @@unique([organizationId, id])
  @@index([organizationId])
}

model PaymentPeriod {
  id             String         @id @default(cuid())
  studentId      String
  academyId      String
  organizationId String
  year           Int
  month          Int
  planId         String
  status         PaymentStatus
  amount         Decimal?       @db.Decimal(10, 2)
  /// The currency `amount` is in — SNAPSHOTTED from `Organization.currency` at
  /// the moment the payment is recorded and never rewritten afterwards (the
  /// same precedent as `OrganizationInvoice.graceDaysApplied`): an academy can
  /// move from colones to dollars, and a record of money that changed hands
  /// must never be retroactively relabelled. A carried-forward promo copies
  /// its source row's currency along with its amount.
  ///
  /// !!! NEVER SUM, AVERAGE OR COMPARE `amount` ACROSS ROWS WITHOUT GROUPING
  /// BY `currency` FIRST. `amount` is a bare decimal: 45 (USD) and 45 (CRC) are
  /// not the same number. Any revenue total, average or threshold must be a
  /// `groupBy` on `currency` (or filtered to one) — a single un-grouped sum is
  /// silently wrong the day an organization changes currency, and nothing
  /// will error. tests/unit/payment-amounts-are-currency-aware.test.ts fails
  /// if a query aggregates PaymentPeriod amounts without mentioning currency.
  ///
  /// No database default, on purpose: a code path that forgets to set it must
  /// fail to compile, not silently record colones for a dollar academy.
  currency       Currency
  notes          String?
  recordedById   String
  recordedAt     DateTime       @default(now())
  // REDESIGN_BRIEF.md Phase 6.2 additions — recordedById/recordedAt above
  // already existed pre-brief, so only these four are new.
  method         PaymentMethod?
  promoName      String?
  promoReason    String?
  promoRecurring Boolean        @default(false)

  student      Student      @relation(fields: [organizationId, studentId], references: [organizationId, id])
  academy      Academy      @relation(fields: [organizationId, academyId], references: [organizationId, id])
  plan         PaymentPlan  @relation(fields: [organizationId, planId], references: [organizationId, id])
  recordedBy   User         @relation(fields: [recordedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([studentId, year, month])
  @@index([academyId, year, month])
  @@index([organizationId])
}

model KioskAttempt {
  id              String   @id @default(cuid())
  academyId       String
  organizationId  String
  /// The rate-limit / lockout KEY: the HMAC digest of the kiosk token the
  /// attempt was presented with (the same value stored in
  /// `Academy.kioskTokenHash`). Keyed on the verified token rather than the
  /// caller's IP because `x-forwarded-for` is client-supplied and can be
  /// rotated per request to evade the counter entirely — and, with no reverse
  /// proxy in front, degenerates to one shared "unknown" bucket for everyone.
  kioskTokenHash  String
  /// Best-effort audit metadata ONLY — never part of the rate-limit key, and
  /// never trusted for a security decision (see `kioskTokenHash`).
  ipAddress       String
  success         Boolean
  /// Whether this row counts toward the 5-failure lockout anchor.
  ///
  /// `success: false` alone is too coarse: `already_checked_in` and
  /// `no_active_class` both mean the submitted code was VALID and resolved to a
  /// real active student, and a gate-rejected attempt never had its code
  /// evaluated at all. Counting any of those let five late arrivals, five
  /// double-taps, or a scripted flood of already-blocked requests keep an
  /// entire academy's kiosk locked out. Only a genuine wrong-code guess
  /// (`invalid_code`) is a brute-force signal.
  ///
  /// Defaults to `true` so the provisional row `reserveKioskAttempt` claims
  /// before the code is evaluated is presumed a guess failure: that is what
  /// caps a burst of CONCURRENT reservations at five, since none of them has
  /// been finalized yet when the next one reads the window.
  /// `finalizeKioskAttempt` clears it once the real outcome is known.
  countsAsFailure Boolean  @default(true)
  createdAt       DateTime @default(now())

  academy      Academy      @relation(fields: [organizationId, academyId], references: [organizationId, id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([academyId, kioskTokenHash, createdAt])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 2c-iii: null for an automated
  /// system action - "do not invent a human actor" applies to the audit trail
  /// too, not just Promotion.awardedById. (No promotion is automatic any more;
  /// historical AUTO promotion rows are kept.) Same nullability reasoning as organizationId
  /// below: a real absence, not a data gap.
  actorId        String?
  academyId      String?
  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 1, Appendix C decision 2. Cannot
  /// be derived through academyId alone: organization-level actions (approve,
  /// suspend, grace change, invoice — Phase 6) have no academy at all, and a
  /// join through a null academyId would yield null for exactly the rows
  /// Phase 6's audit trail needs. Nullable covers genuine platform-level entries.
  organizationId String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  actor        User?         @relation(fields: [actorId], references: [id])
  academy      Academy?      @relation(fields: [academyId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([organizationId])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  /// MULTI_ACADEMY_AND_KIDS_BELTS.md Phase 1, Appendix C decision 3 (revised
  /// in rev 15): NOT NULL, unlike AuditLog's nullable organizationId. The
  /// difference is who reads the row — AuditLog has exactly one reader (the
  /// platform admin), so a null there has one well-defined meaning
  /// ("platform-level, not tenant-visible"). Notification is read by tenant
  /// users, so a null has no defined audience: for a user in two
  /// organizations, it would have to appear under both or neither, which is
  /// a cross-tenant visibility decision made by omission, not a real answer.
  /// Every NotificationType today (STRIPE_THRESHOLD, EXAM_THRESHOLD,
  /// NEW_SIGNUP, WEEKLY_DIGEST) already derives from one academy, so nothing
  /// requires the null case to exist.
  organizationId String
  type           NotificationType
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, readAt])
  @@index([organizationId])
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

/// C1 (docs/MULTI_ACADEMY_AND_KIDS_BELTS.md): platform-level, like Organization/User —
/// deliberately NOT in tenant-guard.ts's TENANT_SCOPED_MODELS (a scheduled job spans every
/// organization, it does not belong to one). One row per invocation of a scheduled job
/// (weekly-digest), written by src/lib/jobs/run-scheduled-job.ts.
/// This is JobRun's OWN state — nothing reads AuditLog to know when a job last ran or how
/// it went ("an audit log records what happened; it must never be what a code path depends
/// on" — the same rule Student.statusBeforeArchive follows).
model JobRun {
  id                     String    @id @default(cuid())
  jobName                String
  status                 JobStatus @default(RUNNING)
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?
  sent                   Int       @default(0)
  failed                 Int       @default(0)
  skipped                Int       @default(0)
  organizationsProcessed Int       @default(0)
  /// Capped array of { organizationId, sent, failed, skipped } (MAX_BREAKDOWN_ENTRIES in
  /// run-scheduled-job.ts) — ids and counts only, never a name, email or other detail a
  /// wider, un-tenant-scoped audience shouldn't see just by reading this table.
  organizationBreakdown  Json?
  /// Truncated join of the run's own caught/thrown error messages (MAX_ERROR_SUMMARY_LENGTH)
  /// — a diagnostic breadcrumb, not a parseable structure.
  errorSummary           String?
  /// The Healthchecks.io ping's own outcome ("ok" | "failed" | "not_configured"). Written in
  /// a SEPARATE update AFTER the fields above are already committed — see
  /// run-scheduled-job.ts's own comment for why that ordering is deliberate.
  heartbeatStatus        String?

  @@index([jobName, startedAt])
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma
/prisma/dev.db

# Real Alliance parity baselines (scripts/alliance-baseline.ts) — contain
# student names and code hashes, never committed. The CI seed<->migration
# parity check's synthetic snapshot lives under ci/seed-snapshots/ instead,
# a deliberately separate, committable path so the two can never be confused.
/baselines/

# Claude Code tooling
.claude/
.claude-flow/

# Auto-installed skill tooling (same category as .claude/ above) — not
# project source.
.agents/
skills-lock.json

# Playwright MCP's own scratch screenshot/trace output from manual
# in-session checks — never project deliverables.
.playwright-mcp/

# ci-parity-check.ts's own before/after snapshots — regenerated on every
# run (scripts/ci-parity-check.ts), uploaded as a CI artifact, never a
# stored baseline. Contrast with /baselines/ above, which holds real data
# and is excluded for a different reason.
/ci/seed-snapshots/

/src/generated/

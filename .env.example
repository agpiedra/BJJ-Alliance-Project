# Silences dotenv's own promotional "tip" line (a real, documented feature
# of the package, not anything injected — see this repo's own doc note on
# why an agent-read console is not a safe place for a dependency's
# arbitrary third-party strings, even when today's payload is only an ad).
DOTENV_CONFIG_QUIET="true"
#
# DATABASE_URL is what the RUNNING APP connects with. In production it is the
# POOLED connection string (Supabase Supavisor, transaction mode, port 6543),
# exactly as Supabase gives it: NO `?pgbouncer=true` (a Prisma engine
# parameter; inert under this app's node-postgres driver adapter) and NO TLS
# parameters (`sslmode`, ...) — TLS is configured by DATABASE_SSL_CA_B64
# below, and the app refuses a URL that carries both because node-postgres
# lets URL parameters silently override it. See docs/DEPLOYMENT_RUNBOOK.md,
# "Connection pooling" and "SSL to the pooler".
DATABASE_URL="postgresql://alliance:alliance_dev_password@localhost:5432/alliance_bjj?schema=public"
# REQUIRED in production for any non-local database (the app refuses to start
# without it — plaintext is node-postgres' default): the database provider's
# CA certificate FILE, base64-encoded (`base64 -w0 ca.crt`). Public, not a
# secret. Full verification: chain AND hostname. Set it for the same Vercel
# environments as DATABASE_URL, including Build. Unused locally.
# DATABASE_SSL_CA_B64=""
# TEMPORARY FALLBACK, instead of the line above and never both: encrypts but
# does NOT verify the server. Warns on every start. Owner and exit condition:
# docs/DEPLOYMENT_RUNBOOK.md, "SSL fallback".
# DATABASE_SSL_MODE="no-verify"
# OPTIONAL locally, REQUIRED wherever `prisma migrate deploy` runs against a
# pooled database: the DIRECT connection string (Supabase port 5432) the Prisma
# CLI uses for migrations. Unset = the CLI uses DATABASE_URL, which is correct
# for local dev and CI (no pooler in front). Must name the SAME database as
# DATABASE_URL — prisma7.config.ts refuses to run otherwise. Set it only on the
# trusted machine that runs migrations, never in the deployed app's environment.
# A REMOTE DIRECT_URL must end `?sslmode=require&sslaccept=strict&sslcert=<path
# to the CA file>`: on the Prisma CLI, `sslmode` alone does NOT verify the
# certificate (even sslmode=verify-full) — only sslaccept=strict does.
# DIRECT_URL="postgresql://alliance:alliance_dev_password@localhost:5432/alliance_bjj?schema=public"
# Dedicated integration-test database — a separate docker-compose service
# (postgres_test), never the dev database above. Required to run
# `pnpm test:integration`; scripts/lib/test-database-guard.ts fails loudly if
# it is missing or resolves to the same database as DATABASE_URL.
TEST_DATABASE_URL="postgresql://alliance:alliance_test_password@localhost:5433/alliance_bjj_test?schema=public"
# Empty scratch database Prisma uses to compute what the migration history
# actually produces — required for `prisma migrate dev` and `pnpm
# db:check-drift`. Same Postgres server as DATABASE_URL, different database
# name; never holds real data.
SHADOW_DATABASE_URL="postgresql://alliance:alliance_dev_password@localhost:5432/alliance_bjj_shadow?schema=public"
CODE_PEPPER="replace-with-a-long-random-value-in-real-deployments"
AUTH_SECRET="replace-with-a-long-random-base64-value"
APP_URL="http://localhost:3000"

# Resend (email notifications). Until EMAIL_FROM uses a real verified sending
# domain, Resend's sandbox mode only delivers to the Resend account's own
# verified email address — that's expected, not a bug.
#
# EMAIL_FROM is the PLATFORM's sender identity, shared by every email this
# app sends (staff notifications, registration confirmation, invitations) —
# it must never name a single organization (e.g. "Alliance BJJ"), since the
# same deployment sends on behalf of every organization on the platform.
# An organization's own identity belongs in the subject/body (already the
# case — see messages.notifications.weeklyDigest's own {academyName}
# interpolation), never the From header, which can only ever name one
# thing. Update this to a real verified sending domain once the platform is
# named (src/lib/platform.ts's own PLATFORM_NAME).
RESEND_API_KEY="re_replace_with_your_resend_api_key"
EMAIL_FROM="Platform Notifications <notifications@resend.dev>"
# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when
# triggering the weekly digest route; any random string works locally.
CRON_SECRET="replace-with-a-long-random-value-in-real-deployments"

# OPTIONAL, dev/test only. Leave unset in every real deployment. Enables
# src/app/api/e2e-auth-bypass/route.ts, a session-minting backdoor used only
# for Playwright/manual screenshot verification when NODE_ENV!=="production"
# — it is inert unless both that AND this are true. See its own file header
# for the full gating contract.
# E2E_AUTH_BYPASS_SECRET="replace-with-a-long-random-value-for-local-dev-only"

# Supabase Storage, for organization logo uploads (MULTI_ACADEMY_AND_KIDS_BELTS.md
# Phase 4) — never Postgres bytes. SUPABASE_SERVICE_ROLE_KEY is server-only,
# used exclusively by src/lib/branding/logo-storage.ts; never expose it to
# the client. The bucket is PUBLIC by design (logos render on the
# unauthenticated kiosk screen) — see that file's own comment for why
# nothing else may ever be uploaded to it.
#
# LOCAL .env = a DEV project. Uploading a logo while developing writes a REAL
# object into whichever project SUPABASE_URL names, so production must use a
# SEPARATE project (docs/DEPLOYMENT_RUNBOOK.md, step 2) — never reuse these
# values there.
SUPABASE_URL="https://replace-with-your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
SUPABASE_LOGO_BUCKET="org-branding"
